# =============================================================================
# Non-secret configuration. Passwords live in ../secrets/ and are consumed
# via Docker secrets instead of this file.
# =============================================================================

# --- Domain -------------------------------------------------------------
DOMAIN_NAME=imirzaev.42.fr

# --- MariaDB --------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
# MYSQL_PASSWORD and MYSQL_ROOT_PASSWORD come from Docker secrets, not here.

# --- WordPress --------------------------------------------------------------
WP_TITLE=Inception
WP_URL=https://imirzaev.42.fr

# Regular (non-admin) WordPress user
WP_USER=editor
WP_USER_EMAIL=editor@login.42.fr

# Administrator account. Username must NOT contain admin/Admin/administrator.
WP_ADMIN_USER=superviseur
WP_ADMIN_EMAIL=superviseur@login.42.fr
